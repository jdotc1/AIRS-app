{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:airs:schema:source-annotations:1",
  "title": "AIRS source-annotations v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "matched",
        "missing_dsym",
        "missing_image_uuid",
        "missing_dsym_uuid",
        "uuid_mismatch",
        "architecture_mismatch",
        "ambiguous_dsym",
        "missing_line_table",
        "invalid_dsym",
        "invalid_debug_data",
        "unsupported_debug_format",
        "resource_limit"
      ]
    },
    "image_identity": {
      "type": "object",
      "properties": {
        "architecture": {
          "enum": [
            "arm64",
            "arm64e"
          ]
        },
        "cpu_subtype": {
          "type": "integer",
          "minimum": 0
        },
        "uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "slice_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preferred_base": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{1,16}$"
        },
        "container_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slice_offset": {
          "type": "integer",
          "minimum": 0
        },
        "slice_size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "architecture",
        "cpu_subtype",
        "uuid",
        "slice_sha256",
        "preferred_base",
        "container_sha256",
        "slice_offset",
        "slice_size"
      ],
      "additionalProperties": true
    },
    "attachment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "architecture": {
              "enum": [
                "arm64",
                "arm64e"
              ]
            },
            "cpu_subtype": {
              "type": "integer",
              "minimum": 0
            },
            "uuid": {
              "type": "string",
              "maxLength": 65536
            },
            "slice_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "slice_offset": {
              "type": "integer",
              "minimum": 0
            },
            "slice_size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            }
          },
          "required": [
            "path",
            "architecture",
            "cpu_subtype",
            "uuid",
            "slice_sha256",
            "slice_offset",
            "slice_size"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "inline_chain": {
      "const": "not_evaluated"
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^airsf-[0-9a-f]{64}$"
          },
          "pc": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{1,16}$"
          },
          "status": {
            "enum": [
              "mapped",
              "ambiguous_line",
              "no_line_entry"
            ]
          },
          "name_status": {
            "enum": [
              "unique",
              "duplicate"
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "line": {
                  "type": "integer",
                  "minimum": 0
                },
                "column": {
                  "type": "integer",
                  "minimum": 0
                },
                "discriminator": {
                  "type": "integer",
                  "minimum": 0
                },
                "source_status": {
                  "enum": [
                    "available_unverified",
                    "missing",
                    "unavailable",
                    "relative_path_unresolved"
                  ]
                }
              },
              "required": [
                "path",
                "line",
                "column",
                "discriminator",
                "source_status"
              ],
              "additionalProperties": true
            },
            "maxItems": 8
          }
        },
        "required": [
          "finding_id",
          "pc",
          "status",
          "name_status",
          "candidate_count",
          "locations"
        ],
        "additionalProperties": true
      },
      "maxItems": 50000
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "status",
    "image_identity",
    "attachment",
    "inline_chain",
    "functions",
    "message",
    "limitations"
  ],
  "additionalProperties": true
}
